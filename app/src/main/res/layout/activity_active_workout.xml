<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fit_dark">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="12dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#1AFFFFFF"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE"
                android:textColor="@color/white_40"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.15" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#1AFFFFFF"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_pause_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="⏸"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Overall Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_sets_done"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 sets done"
                android:textColor="@color/white_40"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_sets_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11 remaining"
                android:textColor="@color/white_40"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_overall"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_red" />
    </LinearLayout>

    <!-- Exercise Tabs (HorizontalScrollView) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/ll_exercise_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Main Exercise Card (scrollable content) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Exercise Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="20dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_exercise_number"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EXERCISE 1/3"
                        android:textColor="@color/white_40"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_set_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set 1/4"
                        android:textColor="@color/fit_red"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_pill_red"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_exercise_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bench Press"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="20dp" />

                <!-- Reps & Weight Adjusters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Reps Adjuster -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_dark"
                        android:padding="14dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reps"
                            android:textColor="@color/white_40"
                            android:textSize="11sp"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/btn_reps_minus"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:text="−"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:gravity="center"
                                android:background="@drawable/bg_card_dark"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tv_reps"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="10"
                                android:textColor="@color/white"
                                android:textSize="24sp"
                                android:fontFamily="sans-serif-black"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/btn_reps_plus"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:text="+"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:gravity="center"
                                android:background="@drawable/bg_card_dark"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Weight Adjuster -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_dark"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weight"
                            android:textColor="@color/white_40"
                            android:textSize="11sp"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/btn_weight_minus"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:text="−"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:gravity="center"
                                android:background="@drawable/bg_card_dark"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tv_weight"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="80kg"
                                android:textColor="@color/white"
                                android:textSize="24sp"
                                android:fontFamily="sans-serif-black"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/btn_weight_plus"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:text="+"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:gravity="center"
                                android:background="@drawable/bg_card_dark"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Sets Tracker Row -->
            <LinearLayout
                android:id="@+id/ll_sets_tracker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp" />

            <!-- Rest Timer Card (hidden by default) -->
            <LinearLayout
                android:id="@+id/ll_rest_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REST"
                        android:textColor="@color/white_40"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:id="@+id/tv_rest_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60s"
                        android:textColor="@color/fit_blue"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_skip_rest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skip"
                    android:textColor="@color/fit_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_blue"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_prev_exercise"
            android:layout_width="52dp"
            android:layout_height="@dimen/button_height"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:cardElevation="0dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="‹"
                android:textColor="@color/white_40"
                android:textSize="24sp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_complete_set"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="✓  Complete Set"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_red_ripple"
            android:layout_marginEnd="10dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_next_exercise"
            android:layout_width="52dp"
            android:layout_height="@dimen/button_height"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="›"
                android:textColor="@color/white_40"
                android:textSize="24sp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</LinearLayout>
